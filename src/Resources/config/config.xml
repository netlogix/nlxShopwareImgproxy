<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>Basics</title>
        <input-field type="bool">
            <name>enable</name>
            <label>Enable imgproxy</label>
            <defaultValue>0</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>enableHtmlPreconnect</name>
            <label>Enable HTML preconnect</label>
            <defaultValue>1</defaultValue>
        </input-field>

        <input-field type="url">
            <name>baseUrl</name>
            <label>BaseUrl of the imgproxy</label>
            <required>false</required>
        </input-field>

        <input-field type="single-select">
            <name>resizeType</name>
            <label>Resize type</label>
            <required>false</required>
            <options>
                <option>
                    <id>0</id>
                    <name>empty</name>
                </option>
                <option>
                    <id>fit</id>
                    <name>fit</name>
                </option>
                <option>
                    <id>fill</id>
                    <name>fill</name>
                </option>
                <option>
                    <id>fillDown</id>
                    <name>fillDown</name>
                </option>
                <option>
                    <id>force</id>
                    <name>force</name>
                </option>
                <option>
                    <id>auto</id>
                    <name>auto</name>
                </option>
            </options>
        </input-field>

        <input-field type="text">
            <name>imageSource</name>
            <label>ImageSourceimgproxy</label>
            <required>false</required>
        </input-field>
    </card>

    <card>
        <title>Secure imgproxy</title>
        <input-field type="text">
            <name>key</name>
            <label>imgproxy key</label>
            <required>false</required>
        </input-field>

        <input-field type="password">
            <name>salt</name>
            <label>imgproxy salt</label>
            <required>false</required>
        </input-field>
    </card>
</config>
